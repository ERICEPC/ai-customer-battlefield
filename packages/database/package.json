{
  "name": "@battlefield/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @battlefield/core build",
    "build": "tsc -p tsconfig.json",
    "premigrate": "pnpm build",
    "migrate": "node dist/cli/migrate.js",
    "pretypecheck": "pnpm --filter @battlefield/core build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @battlefield/core build",
    "test": "vitest run --exclude test/postgres-migrations.postgres.test.ts",
    "pretest:postgres": "pnpm --filter @battlefield/core build",
    "test:postgres": "vitest run test/postgres-migrations.postgres.test.ts"
  },
  "dependencies": {
    "@battlefield/core": "workspace:*",
    "kysely": "^0.29.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1"
  }
}
