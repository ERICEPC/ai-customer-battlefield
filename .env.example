# PostgreSQL-backed API. Use a dedicated database and run migrations explicitly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/battlefield
WEB_ORIGIN=http://localhost:3000

# Reminder worker. Run as a separate process against the same migrated database.
WORKER_TENANT_ID=10000000-0000-4000-8000-000000000001
WORKER_USER_ID=30000000-0000-4000-8000-000000000001
WORKER_BATCH_SIZE=50
WORKER_IDLE_POLL_MS=5000
WORKER_BUSY_POLL_MS=50
WORKER_LEASE_MS=60000

# Browser client API endpoint and synthetic development identity.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_DEV_TENANT_ID=10000000-0000-4000-8000-000000000001
NEXT_PUBLIC_DEV_USER_ID=30000000-0000-4000-8000-000000000001
NEXT_PUBLIC_DEV_USER_DISPLAY_NAME=alpha-owner
NEXT_PUBLIC_DEV_ENTITY_ID=50000000-0000-4000-8000-000000000001
